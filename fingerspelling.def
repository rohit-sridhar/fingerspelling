Bootstrap: docker
From: ubuntu:latest

%environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC
    export PATH=/usr/local/bin:$PATH

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC

    # Set up working directory inside the container
    mkdir -p /data/hmm_modeling/fingerspelling
    mkdir -p /root/.tmp

    # Configure architectures and update system
    dpkg --add-architecture i386
    apt-get update -y && apt-get upgrade -y
    
    # Install multi-arch compiler and development tools
    apt-get install -y \
        build-essential gcc-multilib g++-multilib \
        jq vim autoconf gdb curl \
        libx11-dev:i386 libx11-dev libc6-dev-i386 libc6-dev

    # Note: Copying files happens after this block. 
    # The installation of scripts copied from .dockerbuild has been moved lower.

    # Install core prerequisites and add the deadsnakes PPA
    apt-get install -y --no-install-recommends \
        software-properties-common \
        gpg-agent
    add-apt-repository ppa:deadsnakes/ppa -y

    # Install Python 3.9 and development headers
    apt-get install -y --no-install-recommends \
        python3.9 \
        python3.9-dev \
        python3.9-distutils \
        curl

    # Install the correct pip version for Python 3.9
    curl -sS https://bootstrap.pypa.io/pip/3.9/get-pip.py | python3.9

    # Set Python 3.9 as the default commands
    ln -sf /usr/bin/python3.9 /usr/bin/python3
    ln -sf /usr/bin/python3.9 /usr/bin/python
    ln -sf /usr/local/bin/pip3.9 /usr/bin/pip3
    ln -sf /usr/local/bin/pip3.9 /usr/bin/pip

    # Verify the installations
    python --version && pip --version

    # Install python libraries
    pip install numpy pandas matplotlib pyarrow fastparquet
    pip install tqdm pytest

    # Install copilot
    curl -fsSL https://gh.io/copilot-install | bash

    # Clean up apt package cache to keep image small
    rm -rf /var/lib/apt/lists/*

%files
    # Copies contents of local .dockerbuild folder to the container''s root (/)
    # Singularity handles file transfers AFTER the initial environment setup
    /storage/home/hcoda1/5/rsridhar37/r-ts133-0/fingerspelling/.dockerbuild/* /

%post
    # This second post block runs after %files to execute your custom script
    chmod +x /install_tools.sh
    /install_tools.sh

%runscript
    # Changes directory on container execution and starts bash
    cd /data/hmm_modeling/fingerspelling
    exec bash

